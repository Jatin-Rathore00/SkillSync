# =============================================================================
# SkillSync .gitignore (Full-Stack Monorepo)
# =============================================================================

# 1. Dependency Directories
node_modules/
*/node_modules/
package-lock.json.backup

# 2. Environment Variables & Secrets (CRITICAL: Never commit credentials)
.env
.env.*
!.env.example
*.env
*.local

# 3. Production Builds & Outputs
dist/
*/dist/
dist-ssr/
*/dist-ssr/
build/
*/build/
out/

# 4. Logs & Debug Artifacts
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# 5. OS & File System Artifacts
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# 6. IDE & Editor Artifacts
.vscode/
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.bak
*.tmp
